<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.datasurface.builder</groupId>
    <artifactId>datasurface-image-runtime</artifactId>
    <version>1</version>
    <packaging>pom</packaging>

    <properties>
        <datasurface.version>0.0.0</datasurface.version>
        <gitlab.maven.repository>https://gitlab.com/api/v4/projects/77796931/packages/maven</gitlab.maven.repository>
    </properties>

    <!-- Jackson is required by the DataSurface Java runner itself. -->
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>
    </dependencies>

    <!--
      Every remaining binary is resolved by Maven during the customer's image
      build. The three com.datasurface artifacts are the only private binaries.
    -->
    <profiles>
        <profile>
            <id>datasurface</id>
            <repositories>
                <repository>
                    <id>gitlab-datasurface</id>
                    <url>${gitlab.maven.repository}</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>com.datasurface</groupId>
                    <artifactId>datasurface-core</artifactId>
                    <version>${datasurface.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>datasurface-aws</id>
            <repositories>
                <repository>
                    <id>gitlab-datasurface</id>
                    <url>${gitlab.maven.repository}</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>com.datasurface</groupId>
                    <artifactId>datasurface-hsm-aws</artifactId>
                    <version>${datasurface.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>datasurface-azure</id>
            <repositories>
                <repository>
                    <id>gitlab-datasurface</id>
                    <url>${gitlab.maven.repository}</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>com.datasurface</groupId>
                    <artifactId>datasurface-hsm-azure</artifactId>
                    <version>${datasurface.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>postgresql</id>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>42.7.11</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>sqlserver</id>
            <dependencies>
                <dependency>
                    <groupId>com.microsoft.sqlserver</groupId>
                    <artifactId>mssql-jdbc</artifactId>
                    <version>12.8.2.jre11</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>snowflake</id>
            <dependencies>
                <dependency>
                    <groupId>net.snowflake</groupId>
                    <artifactId>snowflake-jdbc</artifactId>
                    <version>3.24.2</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>trino</id>
            <dependencies>
                <dependency>
                    <groupId>io.trino</groupId>
                    <artifactId>trino-jdbc</artifactId>
                    <version>480</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>aws</id>
            <dependencies>
                <dependency>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>kms</artifactId>
                    <version>2.39.6</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>azure</id>
            <dependencies>
                <dependency>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-security-keyvault-keys</artifactId>
                    <version>4.11.0</version>
                </dependency>
                <dependency>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-identity</artifactId>
                    <version>1.16.3</version>
                </dependency>
            </dependencies>
        </profile>

        <!-- Restricted drivers are opt-in and require customer license approval. -->
        <profile>
            <id>mysql</id>
            <dependencies>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <version>9.3.0</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>oracle</id>
            <dependencies>
                <dependency>
                    <groupId>com.oracle.database.jdbc</groupId>
                    <artifactId>ojdbc17</artifactId>
                    <version>23.26.2.0.0</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>db2</id>
            <dependencies>
                <dependency>
                    <groupId>com.ibm.db2</groupId>
                    <artifactId>jcc</artifactId>
                    <version>12.1.4.0</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
